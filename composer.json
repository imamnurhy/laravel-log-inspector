{
    "name": "explorin/laravel-log-inspector",
    "description": "Production-ready, memory-efficient Laravel log reader, search engine, and blade dashboard.",
    "license": "MIT",
    "authors": [
        {
            "name": "Explorin",
            "email": "dev@explorin.io"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0",
        "illuminate/auth": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.11",
        "laravel/pint": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Explorin\\LogInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Explorin\\LogInspector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Explorin\\LogInspector\\LogInspectorServiceProvider"
            ],
            "aliases": {
                "LogInspector": "Explorin\\LogInspector\\Facades\\LogInspector"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
